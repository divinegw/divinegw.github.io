---
// Linha com nome e botões: vídeo, vídeo do CM, guia em texto e Wiki (cada um opcional).
// Use <Boss> (Wings, Fractals) ou <Path> (Dungeons).
// `texto` troca o que aparece na linha; `nome` continua nos rótulos dos botões (leitor de tela).
import { lucide } from '../lib/lucide';

// `painel`: id da ficha de CM do boss (Boss.astro). O botão "CM" vira um botão dividido dourado:
// "▶ CM" (vídeo) | "O que muda ⌄" (abre e fecha a ficha). Sem script e no PDF, só a metade do vídeo aparece.
interface Props { classe: 'boss' | 'path'; nome: string; texto?: string; video?: string; cm?: string; guia?: string; wiki?: string; painel?: string }
const { classe, nome, texto, video, cm, guia, wiki, painel } = Astro.props;
type L = { url: string; icone: string; texto: string; rotulo: string; cm?: boolean };
const links = [
  video && { url: video, icone: 'play', texto: 'Vídeo', rotulo: `Vídeo de ${nome}` },
  cm && { url: cm, icone: 'play', texto: 'CM', rotulo: `CM: vídeo do Challenge Mode de ${nome}`, cm: true },
  guia && { url: guia, icone: 'file-text', texto: 'Guia', rotulo: `Guia em texto de ${nome}` },
  wiki && { url: wiki, icone: 'book-open', texto: 'Wiki', rotulo: `${nome} na Wiki` },
].filter(Boolean) as L[];
---
<div class={classe}><span>{texto ?? nome}</span><span class="links">{links.map((l) => l.cm && painel
  ? <span class="cm-par"><a href={l.url} target="_blank" rel="noopener" aria-label={l.rotulo}><Fragment set:html={lucide(l.icone)} />{l.texto}</a><button type="button" class="boss-cm-botao" aria-expanded="false" aria-controls={painel} aria-label={`O que muda no Challenge Mode de ${nome}`}>O que muda<Fragment set:html={lucide('chevron-down')} /></button></span>
  : <a href={l.url} target="_blank" rel="noopener" aria-label={l.rotulo}><Fragment set:html={lucide(l.icone)} />{l.texto}</a>)}</span></div>

<style>
  /* vários botões na mesma linha; no celular o nome fica numa linha e os botões embaixo, alinhados à esquerda */
  .links { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: var(--space-1-5); }
  @media (max-width: 640px) { /* --bp-md */
    div:has(> .links) { flex-direction: column; align-items: stretch; gap: var(--space-2); }
    .links { justify-content: flex-start; }
  }
</style>
