---
// Botão do design system. Com `href` vira link (<a>); sem, <button>.
//   variante: primario (ação principal, um por bloco) · secundario (contorno) · icone (só o ícone; exige `rotulo`)
//   tamanho:  md (padrão, 36px) · sm (32px, linhas de vídeo) · lg (44px, cards da home)
//   icone:    nome de um ícone Lucide (lucide.dev/icons), à esquerda do texto
//   rotulo:   nome para leitor de tela (obrigatório no `icone`; nos outros, quando o texto sozinho não basta)
//   desativado: <button disabled> ou <a aria-disabled="true"> sem destino
import { lucide } from '../lib/lucide';

interface Props {
  variante?: 'primario' | 'secundario' | 'icone';
  tamanho?: 'sm' | 'md' | 'lg';
  href?: string;
  icone?: string;
  rotulo?: string;
  desativado?: boolean;
  download?: boolean;
  externo?: boolean;
  type?: 'button' | 'submit';
  class?: string;
  [k: `data-${string}`]: string | undefined;
}
const { variante = 'secundario', tamanho = 'md', href, icone, rotulo, desativado, download, externo, type = 'button', class: extra, ...resto } = Astro.props;
if (variante === 'icone' && !rotulo) throw new Error('Botao variante="icone" precisa de `rotulo` (nome para leitor de tela).');
const classes = ['btn', `btn-${variante}`, tamanho !== 'md' && `btn-${tamanho}`, extra];
const svg = icone ? lucide(icone) : '';
---
{href && !desativado
  ? <a class:list={classes} href={href} aria-label={rotulo} download={download || undefined}
      target={externo ? '_blank' : undefined} rel={externo ? 'noopener' : undefined} {...resto}>
      <Fragment set:html={svg} /><slot />
    </a>
  : href
    ? <a class:list={classes} aria-disabled="true" role="link" aria-label={rotulo} {...resto}><Fragment set:html={svg} /><slot /></a>
    : <button class:list={classes} type={type} aria-label={rotulo} disabled={desativado} {...resto}><Fragment set:html={svg} /><slot /></button>}
