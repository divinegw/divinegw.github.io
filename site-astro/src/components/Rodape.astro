---
// Rodapé: faixa escura nos dois temas (.tema-escuro).
//   em cima, três colunas: marca (logo DIVINE monocromática, frase, "Entrar no Discord") · Guias (2 colunas de links,
//   o aberto em ouro, aria-current) · Comunidade (Discord, GitHub). No celular: a marca em cima, Guias e Comunidade lado a lado.
//   embaixo de um fio: "© <ano> Guilda DIVINE. Todos os direitos reservados." e, nas páginas longas, "Voltar ao topo",
//   na mesma linha; depois o aviso legal na largura toda: uma frase de site de fã em português e o aviso
//   obrigatório da ArenaNet em inglês, sem alteração (Content Terms of Use, II.5, versão de 28/10/2025).
// O ano sai da data da build. Rodapé completo: pedido do usuário na Fase 5 (a assinatura antiga saiu na Fase 4).
//   atual:   slug do guia aberto (marca o link com aria-current)
//   atalhos: mostra "Voltar ao topo" (padrão: não)
//   exemplo: versão para a vitrine (rótulos próprios, sem landmark de rodapé repetido)
// Revelação: quando vem logo depois de um <div class="pagina">, a página sobe e o rodapé aparece por baixo
// (position: sticky, só CSS). Com "reduzir movimento" ele fica parado no fim. No PDF não aparece.
import LogoDivine from './LogoDivine.astro';
import Botao from './Botao.astro';
import { lucide } from '../lib/lucide';
import { AVISO, GUIAS, SITE } from '../site';

interface Props { atual?: string; atalhos?: boolean; exemplo?: boolean }
const { atual, atalhos, exemplo } = Astro.props;
const Tag = exemplo ? 'div' : 'footer';
const ano = new Date().getFullYear();
const seta = lucide('arrow-up-right', 'footer-seta');
const idComunidade = exemplo ? undefined : 'footer-comunidade';
---
<Tag class:list={['footer', 'tema-escuro', { 'is-estatico': exemplo }]}>
  <div class="footer-inner">
    <div class="footer-grade">
      <div class="footer-marca">
        <a class="footer-home" href="/" aria-label={`${SITE.nome}: início`}><LogoDivine altura={36} tarde /></a>
        <p class="footer-frase">{SITE.frase}</p>
        <Botao href={SITE.discord} externo icone="discord" variante="primario" class="footer-discord" rotulo="Entrar no Discord da guilda DIVINE (abre em nova aba)">Entrar no Discord</Botao>
      </div>
      <nav class="footer-col" aria-label={exemplo ? 'Exemplo: guias da guilda' : 'Guias da guilda'}>
        <p class="footer-titulo" aria-hidden="true">Guias</p>
        <ul class="footer-lista footer-guias">
          {GUIAS.map((g) => (
            <li><a href={`/guias/${g.guia}.html`} aria-current={g.guia === atual ? 'page' : undefined}>{g.nome}</a></li>
          ))}
        </ul>
      </nav>
      <div class="footer-col">
        <p class="footer-titulo" id={idComunidade}>Comunidade</p>
        <ul class="footer-lista" aria-labelledby={idComunidade}>
          <li><a href="/novidades.html">Novidades do site</a></li>
          <li><a href="/galeria.html" aria-current={atual === 'galeria' ? 'page' : undefined}>Galeria de artes</a></li>
          <li><a href="/sorteio.html" aria-current={atual === 'sorteio' ? 'page' : undefined}>Sorteio</a></li>
          <li><a href="/creditos.html" aria-current={atual === 'creditos' ? 'page' : undefined}>Créditos e licenças</a></li>
          <li><a href={SITE.discord} target="_blank" rel="noopener">Discord da guilda<Fragment set:html={seta} /><span class="sr-only"> (abre em nova aba)</span></a></li>
          <li><a href={SITE.github} target="_blank" rel="noopener">DIVINE no GitHub<Fragment set:html={seta} /><span class="sr-only"> (abre em nova aba)</span></a></li>
        </ul>
      </div>
    </div>
    <div class="footer-base">
      <div class="footer-linha">
        <p class="footer-direitos">© {ano} {SITE.nome}. {AVISO.direitos}</p>
        {atalhos && <p class="footer-topo"><a href="#">Voltar ao topo<Fragment set:html={lucide('arrow-up', 'footer-seta')} /></a></p>}
      </div>
      <div class="footer-legal">
        <p>{AVISO.fa}</p>
        {/* aviso obrigatório da ArenaNet, em inglês e sem alteração (texto em site.ts › AVISO) */}
        <p lang="en">{AVISO.arenanet}</p>
      </div>
    </div>
  </div>
</Tag>
