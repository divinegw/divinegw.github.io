---
// Vitrine do design system. Fase 1: fundamentos (cada token no tema atual e o contraste
// de todos os pares nos dois temas, ao vivo). Fase 2: componentes base (vitrine/Componentes.astro).
import Cabeca from '../components/Cabeca.astro';
import Cabecalho from '../components/Cabecalho.astro';
import Sumario from '../components/Sumario.astro';
import Rodape from '../components/Rodape.astro';
import CopiarLink from '../components/CopiarLink.astro';
import Chip from '../components/Chip.astro';
import Componentes from '../components/vitrine/Componentes.astro';
import ComponentesGuia from '../components/vitrine/ComponentesGuia.astro';
import { SITE } from '../site';

const capitulos = [
  { id: 'cores', titulo: 'Cores' },
  { id: 'contraste', titulo: 'Contraste' },
  { id: 'tipografia', titulo: 'Tipografia' },
  { id: 'espacamento', titulo: 'Espaçamento' },
  { id: 'raios', titulo: 'Raios' },
  { id: 'sombras', titulo: 'Sombras' },
  { id: 'movimento', titulo: 'Movimento' },
  { id: 'estrutura', titulo: 'Camadas e layout' },
  { id: 'botoes', titulo: 'Botões' },
  { id: 'links', titulo: 'Links' },
  { id: 'chips', titulo: 'Chips e selos' },
  { id: 'cards', titulo: 'Cards' },
  { id: 'avisos', titulo: 'Avisos' },
  { id: 'tabela', titulo: 'Tabela' },
  { id: 'sumario', titulo: 'Sumário' },
  { id: 'cabecalho', titulo: 'Cabeçalho' },
  { id: 'rodape', titulo: 'Rodapé' },
  { id: 'copiar', titulo: 'Copiar link' },
  { id: 'termo', titulo: 'Termo com definição' },
  { id: 'encontro', titulo: 'Card de boss' },
  { id: 'abas', titulo: 'Abas' },
  { id: 'funcoes', titulo: 'Etiquetas de função' },
  { id: 'efeitos', titulo: 'Boons e conditions' },
  { id: 'linha', titulo: 'Linha do tempo' },
  { id: 'banner', titulo: 'Banner com revelação' },
  { id: 'recurso', titulo: 'Card de recurso' },
  { id: 'mapa', titulo: 'Tabela de mapa' },
  { id: 'dungeon', titulo: 'Dungeon e Path' },
  { id: 'ficha-cm', titulo: 'Ficha de CM do boss' },
  { id: 'novidades-ds', titulo: 'Novidades' },
];

const semanticos = [
  { titulo: 'Superfícies', itens: [
    ['bg', 'fundo da página'], ['surface', 'cards, botões, sumário'], ['surface-2', 'chips, cabeçalho de tabela, código'],
  ] },
  { titulo: 'Texto', itens: [
    ['text', 'títulos e texto corrido'], ['text-soft', 'subtítulos, descrições'], ['text-mute', 'rótulos, migalha'],
  ] },
  { titulo: 'Bordas', itens: [
    ['line', 'bordas e divisórias'], ['line-strong', 'hover de card, barra de rolagem'],
  ] },
  { titulo: 'Destaque e ação', itens: [
    ['accent', 'anel do emblema, hover de borda (só decoração)'], ['accent-text', 'links e texto de destaque'],
    ['gold', 'números de capítulo, item ativo, datas'], ['action-bg', 'botão principal'], ['focus-ring', 'anel de foco do teclado']
  ] },
];

const rampas = [
  { titulo: 'Azul-marinho', nota: 'anel da logo: links, botão e foco no claro', tokens: ['navy-100', 'navy-300', 'navy-500', 'navy-600', 'navy-700', 'navy-800', 'navy-900'] },
  { titulo: 'Ouro', nota: 'nós e estrelas da logo: números, item ativo, botão e links no escuro', tokens: ['gold-100', 'gold-200', 'gold-300', 'gold-400', 'gold-500', 'gold-600', 'gold-700', 'gold-800'] },
  { titulo: 'Prata', nota: 'nós da logo: texto secundário no escuro', tokens: ['silver-100', 'silver-300', 'silver-500', 'silver-700'] },
  { titulo: 'Neutros', nota: 'cinza com toque de marinho; branco e preto nunca puros', tokens: ['ink-0', 'ink-25', 'ink-50', 'ink-75', 'ink-100', 'ink-200', 'ink-300', 'ink-400', 'ink-500', 'ink-600', 'ink-700', 'ink-750', 'ink-800', 'ink-850', 'ink-900', 'ink-950', 'ink-1000'] },
];

const profissoes = [['guardian', 'Guardian'], ['revenant', 'Revenant'], ['warrior', 'Warrior'], ['engineer', 'Engineer'], ['ranger', 'Ranger'],
  ['thief', 'Thief'], ['elementalist', 'Elementalist'], ['mesmer', 'Mesmer'], ['necromancer', 'Necromancer']];
const estados = [['info', 'Dica', 'Use o golem de treino antes da primeira raid.'], ['success', 'Feito', 'Build salva no template 1.'],
  ['warning', 'Atenção', 'O CM exige Agony Resistance 150.'], ['danger', 'Importante', 'Não use a Mist Potion antes do boss.']];

// pares de contraste: fundo = camadas de baixo para cima; o pior caso entre os fundos vale
const S = ['var(--bg)'], SF = ['var(--surface)'], S2 = ['var(--surface-2)'];
const superficies = [S, SF, S2];
type Par = { rotulo: string; fg: string; fundos: string[][]; min: number };
const pares: { grupo: string; itens: Par[] }[] = [
  { grupo: 'Texto sobre as superfícies (bg, surface, surface-2)', itens: [
    { rotulo: 'Texto principal · --text', fg: 'var(--text)', fundos: superficies, min: 4.5 },
    { rotulo: 'Texto secundário · --text-soft', fg: 'var(--text-soft)', fundos: superficies, min: 4.5 },
    { rotulo: 'Texto apagado · --text-mute', fg: 'var(--text-mute)', fundos: superficies, min: 4.5 },
    { rotulo: 'Link · --accent-text', fg: 'var(--accent-text)', fundos: superficies, min: 4.5 },
    { rotulo: 'Dourado · --gold', fg: 'var(--gold)', fundos: superficies, min: 4.5 },
  ] },
  { grupo: 'Texto sobre fundos coloridos', itens: [
    { rotulo: 'Texto no destaque marinho/ouro', fg: 'var(--text)', fundos: [[...SF, 'var(--accent-tint)'], [...S, 'var(--accent-tint)']], min: 4.5 },
    { rotulo: 'Texto na nota dourada', fg: 'var(--text)', fundos: [[...SF, 'var(--gold-tint)'], [...S, 'var(--gold-tint)']], min: 4.5 },
    { rotulo: 'Dourado na nota e no chip de data', fg: 'var(--gold)', fundos: [[...SF, 'var(--gold-tint)'], [...S, 'var(--gold-tint)']], min: 4.5 },
    { rotulo: 'Botão principal (normal e hover)', fg: 'var(--on-action)', fundos: [['var(--action-bg)'], ['var(--action-bg-hover)']], min: 4.5 },
    { rotulo: 'Botão desativado · --text-mute', fg: 'var(--text-mute)', fundos: [S2], min: 4.5 },
    { rotulo: 'Texto do balão (Termo, link copiado)', fg: 'var(--tip-text)', fundos: [['var(--tip-bg)']], min: 4.5 },
    { rotulo: 'Nome do termo no balão', fg: 'var(--tip-title)', fundos: [['var(--tip-bg)']], min: 4.5 },
    { rotulo: 'Nome sobre a arte (véu 75% sobre arte branca)', fg: 'var(--on-art)', fundos: [['var(--paper)', 'color-mix(in srgb, var(--ink-1000) 75%, transparent)']], min: 4.5 },
    { rotulo: 'Chip sobre a arte', fg: 'var(--on-art)', fundos: [['var(--paper)', 'color-mix(in srgb, var(--ink-1000) 75%, transparent)', 'var(--art-chip-bg)']], min: 4.5 },
  ] },
  { grupo: 'Estados (texto sobre a própria tinta)', itens: estados.map(([id, nome]) => (
    { rotulo: `${nome} · --${id}-text`, fg: `var(--${id}-text)`, fundos: [[...SF], [...SF, `var(--${id}-tint)`], [...S, `var(--${id}-tint)`]], min: 4.5 })) },
  { grupo: 'Profissões (texto)', itens: profissoes.map(([id, nome]) => (
    { rotulo: `${nome} · --prof-${id}-text`, fg: `var(--prof-${id}-text)`, fundos: [...superficies, [...SF, `var(--prof-${id}-tint)`]], min: 4.5 })) },
  { grupo: 'Elementos que não são texto (mínimo 3:1)', itens: [
    { rotulo: 'Anel de foco · --focus-ring', fg: 'var(--focus-ring)', fundos: superficies, min: 3 },
    ...profissoes.map(([id, nome]) => ({ rotulo: `${nome} (ponto, borda) · --prof-${id}`, fg: `var(--prof-${id})`, fundos: [SF, S2], min: 3 })),
  ] },
];

const tipos = [
  { token: 'fs-fluid-h1', faixa: '40 → 64', uso: 'Título da página', classe: 'display', amostra: 'Fractals' },
  { token: 'fs-fluid-feature', faixa: '34 → 44', uso: 'Guia em destaque na home', classe: 'display', amostra: 'Endgame' },
  { token: 'fs-fluid-h2', faixa: '28 → 36', uso: 'Capítulo (h2)', classe: 'display', amostra: 'Instabilidades' },
  { token: 'fs-3xl', faixa: '30', uso: 'Nome do guia nos cards da home', classe: 'display', amostra: 'Dungeons' },
  { token: 'fs-2xl', faixa: '28', uso: 'Título de bloco da home', classe: 'display', amostra: 'Comece por aqui' },
  { token: 'fs-fluid-art', faixa: '21 → 26', uso: 'Nome de wing e dungeon sobre a arte', classe: 'display', amostra: 'Spirit Vale' },
  { token: 'fs-fluid-title', faixa: '19 → 21', uso: 'Título de card (h3)', classe: 'title', amostra: 'Agony Resistance' },
  { token: 'fs-fluid-lead', faixa: '16.5 → 18', uso: 'Frase do topo', classe: 'body', amostra: 'Agony, instabilidades e recompensas diárias.' },
  { token: 'fs-xl', faixa: '18', uso: 'Nome de recurso', classe: 'strong', amostra: 'GW2 Efficiency' },
  { token: 'fs-lg', faixa: '17', uso: 'h4, subtítulo de capítulo, rodapé', classe: 'body', amostra: 'Tudo o que muda a partir do Tier 4.' },
  { token: 'fs-base', faixa: '16', uso: 'Texto corrido', classe: 'body', amostra: 'Cada fractal sorteia até três instabilidades.' },
  { token: 'fs-md', faixa: '15', uso: 'Sumário, tabelas, avisos, descrições', classe: 'body', amostra: 'Recompensas diárias' },
  { token: 'fs-sm', faixa: '14', uso: 'Barra do topo, botões, subitens, balão', classe: 'body', amostra: 'Observação em letra menor.' },
  { token: 'fs-sm-minus', faixa: '13', uso: 'Botão pequeno, "link copiado"', classe: 'body', amostra: 'Vídeo' },
  { token: 'fs-xs', faixa: '12', uso: 'Chips, URLs, rótulos, números do sumário', classe: 'mono', amostra: 'TIER 4 · NÍVEL 76-100' },
  { token: 'fs-2xs', faixa: '11', uso: 'Selos "Novo" e "Atualizado"', classe: 'mono', amostra: 'NOVO' },
];

const espacos = ['px', '0-5', '1', '1-5', '2', '2-5', '3', '3-5', '4', '4-5', '5', '6', '7', '8', '9', '10', '12', '14', '16', '18'];
const raios = [['sm', 'chips, selos, código, foco de link'], ['md', 'botões, ícones, balão; imagens, tabelas e avisos dentro de card'],
  ['lg', 'cards, wings, recursos, sumário no celular'], ['round', 'só o emblema']];
const sombras = [['shadow', 'cards e wings (some no escuro)'], ['shadow-emblem', 'sombra da logo (contorno); no escuro, brilho de ouro'], ['shadow-tip', 'balão do Termo (some no escuro; a borda de ouro separa)']];
const movimentos = [['dur-fast', 'ease-out', 'hover e foco de botões e links'], ['dur-base', 'ease-out', 'card da home que sobe'],
  ['dur-slow', 'ease-emphasized', 'reserva: revelações (Fase 4)']];
const camadas = [['z-art', 'texto sobre arte'], ['z-art-bar', 'barra sobre o herói'], ['z-sticky', 'barra do topo'], ['z-skip', 'pular para o conteúdo'],
  ['z-overlay', 'reserva: menus, Ctrl+K'], ['z-tooltip', 'balão do Termo e do link copiado']];
const dimensoes = [['control-sm', 'botão pequeno, URL, copiar link'], ['control-md', 'botões da barra do topo'], ['control-lg', 'botões principais'],
  ['icon-xs', 'ícone em botão pequeno'], ['icon-sm', 'ícone em botão, aviso, linha'], ['icon-md', 'ícone de card'],
  ['icon-box-sm', 'caixa do ícone de linha'], ['icon-box-md', 'caixa do ícone de card'], ['emblem-sm', 'emblema da barra'], ['emblem-md', 'emblema no celular'],
  ['emblem-lg', 'emblema do topo'], ['tip-max', 'largura máxima do balão'], ['tip-tail', 'ponta do balão']];
const breakpoints = [['bp-sm', 'sumário em 1 coluna, favoritos'], ['bp-md', 'celular'], ['bp-home', 'página inicial'], ['bp-lg', 'recursos em 2 colunas'],
  ['bp-xl', 'sumário fixo à esquerda']];
const medidas = [['w-page', 'largura da página'], ['w-hero', 'texto do herói'], ['w-column', 'coluna do guia'], ['w-sidebar', 'sumário fixo'],
  ['gutter', 'margem lateral'], ['measure-lead', 'frase do topo'], ['measure-sub', 'subtítulo de capítulo']];
---
<!doctype html>
<html lang="pt-BR">
<head>
<Cabeca titulo="Design system" descricao="Tokens do Codex DIVINE: cores, contraste, tipografia, espaçamento, raios, sombras e movimento." caminho="/design-system.html" />
<meta name="robots" content="noindex">
</head>
<body>
<div class="pagina">
<Cabecalho />

<header class="ds-head">
  <h1>Design system</h1>
  <p class="hero-sub">Codex DIVINE · Fundamentos e componentes</p>
  <p class="ds-desc">Os tokens e os componentes que desenham o manual, dos fundamentos aos blocos de guia de GW2. Os fundamentos aparecem no tema atual (troque no botão do topo); os componentes mostram cada estado nos dois temas.</p>
  <ul class="hero-chips"><Chip como="li">tokens.css</Chip><Chip como="li">Fases 1 a 3</Chip><Chip como="li" tom="data">Atualizado em {SITE.atualizado}</Chip></ul>
</header>

<div class="layout">
  <aside class="sidebar">
    <Sumario titulo="Nesta página" plano={false} itens={capitulos.map((c) => ({ id: c.id, text: c.titulo, subs: [] }))} />
  </aside>

  <main id="conteudo" class="content">
    <!-- 01 CORES -->
    <section class="page" aria-labelledby="cores">
      <div class="titulo-secao"><h2 class="section" id="cores" data-num="01">Cores</h2></div>
      <p class="section-sub">Componentes usam só os semânticos. Os primitivos ficam embaixo, para consulta.</p>

      {semanticos.map((g) => (
        <>
          <h3 class="ds-h3">{g.titulo}</h3>
          <ul class="ds-swatches">
            {g.itens.map(([t, uso]) => (
              <li class="ds-swatch">
                <span class="ds-chip" style={`--c:var(--${t})`}></span>
                <code>--{t}</code>
                <span class="ds-val" data-var={t}></span>
                <span class="ds-uso">{uso}</span>
              </li>
            ))}
          </ul>
        </>
      ))}

      <h3 class="ds-h3">Estados</h3>
      <p class="ds-nota">Base das caixas Dica / Atenção / Importante da Fase 2: tinta de 12% e borda de 1px, nunca borda lateral grossa.</p>
      <div class="ds-estados">
        {estados.map(([id, nome, frase]) => (
          <p class="ds-estado" style={`--t:var(--${id}-text);--b:var(--${id}-tint);--l:var(--${id}-line)`}><b>{nome}:</b> {frase}</p>
        ))}
      </div>

      <h3 class="ds-h3">Profissões</h3>
      <p class="ds-nota">Cores da Guild Wars 2 Wiki (Template:Color). No tema claro, o texto e o ponto usam um tom mais escuro da mesma cor para passar no contraste.</p>
      <ul class="ds-tags">
        {profissoes.map(([id, nome]) => <li class="ds-tag" style={`--d:var(--prof-${id});--t:var(--prof-${id}-text);--b:var(--prof-${id}-tint)`}>{nome}</li>)}
      </ul>

      <h3 class="ds-h3">Primitivos</h3>
      {rampas.map((r) => (
        <div class="ds-rampa">
          <p class="ds-rampa-tit"><b>{r.titulo}</b> <span>{r.nota}</span></p>
          <ul>
            {r.tokens.map((t) => <li><span class="ds-chip" style={`--c:var(--${t})`}></span><code>{t}</code><span class="ds-val" data-var={t}></span></li>)}
          </ul>
        </div>
      ))}
    </section>

    <!-- 02 CONTRASTE -->
    <section class="page" aria-labelledby="contraste">
      <div class="titulo-secao"><h2 class="section" id="contraste" data-num="02">Contraste</h2></div>
      <p class="section-sub">WCAG AA: texto 4.5:1, elementos que não são texto 3:1. Cada linha mostra o pior caso entre os fundos onde o par aparece, medido no navegador nos dois temas.</p>
      <p class="ds-resumo" id="ds-resumo" aria-live="polite">Medindo…</p>
      {pares.map((g) => (
        <div class="ds-tabela">
          <table class="map">
            <caption>{g.grupo}</caption>
            <thead><tr><th scope="col">Par</th><th scope="col">Claro</th><th scope="col">Escuro</th><th scope="col">Mínimo</th></tr></thead>
            <tbody>
              {g.itens.map((p) => (
                <tr data-fg={p.fg} data-fundos={JSON.stringify(p.fundos)} data-min={p.min}>
                  <th scope="row">{p.rotulo}</th><td class="ds-r" data-tema="light">…</td><td class="ds-r" data-tema="dark">…</td><td>{p.min}:1</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      ))}
    </section>

    <!-- 03 TIPOGRAFIA -->
    <section class="page" aria-labelledby="tipografia">
      <div class="titulo-secao"><h2 class="section" id="tipografia" data-num="03">Tipografia</h2></div>
      <p class="section-sub">Mona Sans (variável: largura e peso) nos títulos e no texto, Geist Mono nos dados. Servidas pelo próprio site, licença OFL. Os tamanhos fluidos crescem entre 400 e 1280px de tela; no PDF ficam no tamanho de desktop.</p>
      <div class="ds-familias">
        <p class="ds-fam ds-fam-display"><span>Mona Sans · títulos: largura 87.5%, peso 750</span>Fractals of the Mists</p>
        <p class="ds-fam ds-fam-body"><span>Mona Sans · texto: largura 100%, pesos 400/600/700</span>Cada fractal sorteia até três instabilidades por dia.</p>
        <p class="ds-fam ds-fam-mono"><span>Geist Mono 500 · só dados</span>TIER 4 · 76-100 · 150 AR</p>
      </div>
      <ul class="ds-escala">
        {tipos.map((t) => (
          <li>
            <div class="ds-escala-meta"><code>--{t.token}</code><span>{t.faixa}px · agora <b class="ds-px" data-fs={t.token}></b></span><span>{t.uso}</span></div>
            <p class={`ds-amostra ds-${t.classe}`} style={`font-size:var(--${t.token})`}>{t.amostra}</p>
          </li>
        ))}
      </ul>
    </section>

    <!-- 04 ESPAÇAMENTO -->
    <section class="page" aria-labelledby="espacamento">
      <div class="titulo-secao"><h2 class="section" id="espacamento" data-num="04">Espaçamento</h2></div>
      <p class="section-sub">Grade de 4px com meios-passos de 2px, que o código já usava em botões e chips. O nome é o múltiplo de 4: --space-3 = 12px.</p>
      <ul class="ds-espacos">
        {espacos.map((s) => <li><code>--space-{s}</code><span class="ds-val" data-len={`space-${s}`}></span><span class="ds-barra" style={`width:var(--space-${s})`}></span></li>)}
      </ul>
    </section>

    <!-- 05 RAIOS -->
    <section class="page" aria-labelledby="raios">
      <div class="titulo-secao"><h2 class="section" id="raios" data-num="05">Raios</h2></div>
      <p class="section-sub">Três passos. Na Fase 2 os drifts viraram o passo mais próximo: 8 → 10 (botões de vídeo, URLs), 12 → 10 (imagens, tabelas, avisos dentro de card; 12 → 14 nos recursos) e 16 → 14 (cards da home).</p>
      <ul class="ds-raios">
        {raios.map(([r, uso]) => <li><span class="ds-raio" style={`border-radius:var(--radius-${r})`}></span><code>--radius-{r}</code><span class="ds-val" data-len={`radius-${r}`}></span><span class="ds-uso">{uso}</span></li>)}
      </ul>
    </section>

    <!-- 06 SOMBRAS -->
    <section class="page" aria-labelledby="sombras">
      <div class="titulo-secao"><h2 class="section" id="sombras" data-num="06">Sombras</h2></div>
      <p class="section-sub">Sombra só no tema claro. No escuro, a profundidade vem da diferença entre bg, surface e surface-2.</p>
      <ul class="ds-sombras">
        {sombras.map(([s, uso]) => <li><span class="ds-sombra" style={s === 'shadow-emblem' ? 'filter:drop-shadow(var(--shadow-emblem))' : `box-shadow:var(--${s})`}></span><code>--{s}</code><span class="ds-uso">{uso}</span></li>)}
      </ul>
    </section>

    <!-- 07 MOVIMENTO -->
    <section class="page" aria-labelledby="movimento">
      <div class="titulo-secao"><h2 class="section" id="movimento" data-num="07">Movimento</h2></div>
      <p class="section-sub">Curto e só em resposta ao usuário: hover e foco. Nada em loop. Com "reduzir movimento" ligado no sistema, tudo para.</p>
      <ul class="ds-movs">
        {movimentos.map(([d, e, uso]) => (
          <li>
            <button type="button" class="ds-mov" style={`--d:var(--${d});--e:var(--${e})`} aria-label={`Testar --${d} com --${e}`}><span></span></button>
            <code>--{d}</code><span class="ds-val" data-time={d}></span><code>--{e}</code><span class="ds-uso">{uso}</span>
          </li>
        ))}
      </ul>
      <p class="ds-nota">Passe o mouse ou foque cada trilho para ver a duração.</p>
    </section>

    <!-- 08 CAMADAS E LAYOUT -->
    <section class="page" aria-labelledby="estrutura">
      <div class="titulo-secao"><h2 class="section" id="estrutura" data-num="08">Camadas e layout</h2></div>
      <p class="section-sub">Breakpoints não podem ser variáveis dentro de @media: os tokens --bp-* documentam o valor, e cada @media cita o token num comentário.</p>
      <div class="ds-tabela">
        <table class="map">
          <caption>Camadas (z-index)</caption>
          <thead><tr><th scope="col">Token</th><th scope="col">Valor</th><th scope="col">Uso</th></tr></thead>
          <tbody>{camadas.map(([t, uso]) => <tr><th scope="row"><code>--{t}</code></th><td class="ds-val" data-raw={t}></td><td>{uso}</td></tr>)}</tbody>
        </table>
      </div>
      <div class="ds-tabela">
        <table class="map">
          <caption>Breakpoints</caption>
          <thead><tr><th scope="col">Token</th><th scope="col">Valor</th><th scope="col">Uso</th></tr></thead>
          <tbody>{breakpoints.map(([t, uso]) => <tr><th scope="row"><code>--{t}</code></th><td class="ds-val" data-raw={t}></td><td>{uso}</td></tr>)}</tbody>
        </table>
      </div>
      <div class="ds-tabela">
        <table class="map">
          <caption>Medidas</caption>
          <thead><tr><th scope="col">Token</th><th scope="col">Valor</th><th scope="col">Uso</th></tr></thead>
          <tbody>{medidas.map(([t, uso]) => <tr><th scope="row"><code>--{t}</code></th><td class="ds-val" data-raw={t}></td><td>{uso}</td></tr>)}</tbody>
        </table>
      </div>
      <div class="ds-tabela">
        <table class="map">
          <caption>Dimensões de componente</caption>
          <thead><tr><th scope="col">Token</th><th scope="col">Valor</th><th scope="col">Uso</th></tr></thead>
          <tbody>{dimensoes.map(([t, uso]) => <tr><th scope="row"><code>--{t}</code></th><td class="ds-val" data-raw={t}></td><td>{uso}</td></tr>)}</tbody>
        </table>
      </div>
    </section>

    <Componentes />
    <ComponentesGuia />
  </main>
</div>
