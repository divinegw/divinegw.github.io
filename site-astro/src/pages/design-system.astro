<script is:inline>
(function () {
  var root = document.documentElement;
  var probe = document.createElement('div');
  probe.setAttribute('aria-hidden', 'true');
  probe.style.cssText = 'position:absolute;width:0;height:0;overflow:hidden;visibility:hidden';
  document.body.appendChild(probe);
  var cv = document.createElement('canvas'); cv.width = cv.height = 1;
  var cx = cv.getContext('2d', { willReadFrequently: true });

  function cor(css) { probe.style.backgroundColor = ''; probe.style.backgroundColor = css; return getComputedStyle(probe).backgroundColor; }
  function pinta(camadas) {
    cx.clearRect(0, 0, 1, 1);
    camadas.forEach(function (c) { cx.fillStyle = '#000'; cx.fillStyle = cor(c); cx.fillRect(0, 0, 1, 1); });
    var d = cx.getImageData(0, 0, 1, 1).data; return [d[0], d[1], d[2], d[3]];
  }
  function lum(c) { return c.slice(0, 3).map(function (v) { v /= 255; return v <= 0.04045 ? v / 12.92 : Math.pow((v + 0.055) / 1.055, 2.4); })
    .reduce(function (s, v, i) { return s + v * [0.2126, 0.7152, 0.0722][i]; }, 0); }
  function razao(a, b) { var x = lum(a), y = lum(b); return (Math.max(x, y) + 0.05) / (Math.min(x, y) + 0.05); }
  function hex(c) { return '#' + c.slice(0, 3).map(function (v) { return v.toString(16).padStart(2, '0'); }).join(''); }
  function raw(nome) { return getComputedStyle(root).getPropertyValue('--' + nome).trim(); }

  // valores ao vivo dos swatches (tema atual)
  function atualiza() {
    document.querySelectorAll('[data-var]').forEach(function (el) {
      var c = pinta(['var(--' + el.dataset.var + ')']);
      el.textContent = c[3] === 255 ? hex(c) : hex(c) + ' · ' + Math.round(c[3] / 2.55) + '%';
    });
    document.querySelectorAll('[data-len]').forEach(function (el) {
      probe.style.width = 'var(--' + el.dataset.len + ')'; el.textContent = raw(el.dataset.len);
    });
    document.querySelectorAll('[data-raw]').forEach(function (el) { el.textContent = raw(el.dataset.raw); });
    document.querySelectorAll('[data-time]').forEach(function (el) { el.textContent = raw(el.dataset.time); });
    document.querySelectorAll('[data-fs]').forEach(function (el) {
      probe.style.fontSize = 'var(--' + el.dataset.fs + ')';
      el.textContent = parseFloat(getComputedStyle(probe).fontSize).toFixed(1).replace('.0', '') + 'px';
    });
  }

  // contraste nos dois temas: troca o tema por um instante, mede e devolve
  function mede() {
    var antes = root.getAttribute('data-theme'), falhas = 0, total = 0;
    ['light', 'dark'].forEach(function (tema) {
      root.setAttribute('data-theme', tema);
      document.querySelectorAll('tr[data-fg]').forEach(function (tr) {
        var fundos = JSON.parse(tr.dataset.fundos), min = parseFloat(tr.dataset.min), pior = Infinity;
        fundos.forEach(function (f) {
          var base = ['var(--paper)'].concat(f);
          pior = Math.min(pior, razao(pinta(base.concat(tr.dataset.fg)), pinta(base)));
        });
        var td = tr.querySelector('td[data-tema="' + tema + '"]'), ok = pior >= min;
        td.textContent = pior.toFixed(2) + ':1 ' + (ok ? 'passa' : 'falha');
        td.className = 'ds-r ' + (ok ? 'is-ok' : 'is-falha');
        total++; if (!ok) falhas++;
      });
    });
    if (antes) root.setAttribute('data-theme', antes); else root.removeAttribute('data-theme');
    var r = document.getElementById('ds-resumo');
    r.textContent = falhas ? falhas + ' de ' + total + ' medições abaixo do mínimo.' : 'Todas as ' + total + ' medições passam (' + total / 2 + ' pares × 2 temas).';
    r.className = 'ds-resumo ' + (falhas ? 'is-falha' : 'is-ok');
    window.__dsContraste = { total: total, falhas: falhas };
  }

  atualiza(); mede();
  new MutationObserver(atualiza).observe(root, { attributes: true, attributeFilter: ['data-theme'] });
})();
</script>

